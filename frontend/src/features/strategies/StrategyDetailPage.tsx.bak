import React from "react";
import { useEffect, useState } from "react";
import { usePathname } from "../../app/router";
import { apiRequest } from "../../lib/api";
import { Card } from "../../components/ui/Card";
import { Button } from "../../components/ui/Button";
import { Input } from "../../components/ui/Input";
import { Badge } from "../../components/ui/Badge";
import { listRules, createRule, updateRule, deleteRule, reorderRules } from "./strategies.api";

interface RuleItemProps {
  rule: any;
  index: number;
  strategy: any;
  editingRuleId: string | null;
  editingRuleText: string;
  editingRuleRequired: boolean;
  setEditingRuleId: (id: string | null) => void;
  setEditingRuleText: (text: string) => void;
  setEditingRuleRequired: (required: boolean) => void;
  handleUpdateRule: (id: string) => void;
  handleDeleteRule: (id: string) => void;
  handleMoveRule: (id: string, direction: "up" | "down") => void;
  startEdit: (rule: any) => void;
}

function RuleItem({
  rule,
  index,
  strategy,
  editingRuleId,
  editingRuleText,
  editingRuleRequired,
  setEditingRuleId,
  setEditingRuleText,
  setEditingRuleRequired,
  handleUpdateRule,
  handleDeleteRule,
  handleMoveRule,
  startEdit,
}: RuleItemProps) {
  if (editingRuleId === rule.id) {
    return (
      <form onSubmit={(e) => { e.preventDefault(); handleUpdateRule(rule.id); }} className="flex flex-col sm:flex-row gap-2 w-full">
        <Input
          value={editingRuleText}
          onChange={(e) => setEditingRuleText(e.target.value)}
          className="flex-1"
        />
        <label className="flex items-center gap-2 whitespace-nowrap">
          <input
            type="checkbox"
            checked={editingRuleRequired}
            onChange={(e) => setEditingRuleRequired(e.target.checked)}
            className="rounded border-border-strong"
          />
          <span className="text-sm text-text-muted">Required</span>
        </label>
        <div className="flex gap-1">
          <Button type="submit" variant="primary" size="sm">Save</Button>
          <Button type="button" variant="ghost" size="sm" onClick={() => setEditingRuleId(null)}>Cancel</Button>
        </div>
      </form>
    );
  }

  return (
    <div className="flex items-center gap-3">
      <p className="flex-1 whitespace-pre-wrap text-sm">{rule.text}</p>
      {rule.isRequired && <Badge variant="positive" size="sm">Required</Badge>}
      <div className="flex gap-1">
        <Button variant="ghost" size="sm" onClick={() => handleMoveRule(rule.id, "up")} disabled={index === 0} title="Move up">Up</Button>
        <Button variant="ghost" size="sm" onClick={() => handleMoveRule(rule.id, "down")} disabled={index === strategy.rules.length - 1} title="Move down">Down</Button>
        <Button variant="ghost" size="sm" onClick={() => startEdit(rule)} title="Edit">Edit</Button>
        <Button variant="ghost" size="sm" className="bg-negative text-white" onClick={() => handleDeleteRule(rule.id)} title="Delete">Delete</Button>
      </div>
    );
  }
}

export function StrategyDetailPage() {
  const pathname = usePathname();
  const [strategy, setStrategy] = useState<any | null>(null);
  const [rules, setRules] = useState<any[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [showAddRuleDialog, setShowAddRuleDialog] = useState(false);
  const [newRuleText, setNewRuleText] = useState("");
  const [newRuleRequired, setNewRuleRequired] = useState(true);
  const [editingRuleId, setEditingRuleId] = useState<string | null>(null);
  const [editingRuleText, setEditingRuleText] = useState("");
  const [editingRuleRequired, setEditingRuleRequired] = useState(true);

  useEffect(() => {
    let cancelled = false;

    async function loadStrategy() {
      try {
        setLoading(true);
        setError(null);

        const parts = pathname.split("/").filter(Boolean);
        const id = parts[1];

        if (!id) throw new Error("No strategy ID in URL");

        const [strategy, rules] = await Promise.all([
          apiRequest<any>(`/strategies/${id}`),
          listRules(id),
        ]);

        if (!cancelled) {
          setStrategy({
            id: strategy.id,
            name: strategy.name,
            description: strategy.description,
            category: strategy.category,
            status: strategy.status,
            color: strategy.color,
            rules: strategy.rules || [],
            tradeCount: strategy.tradeCount,
          });
          setRules(strategy.rules || []);
        }
      } catch (err) {
        if (!cancelled) setError(err instanceof Error ? err.message : "Failed to load strategy");
      } finally {
        if (!cancelled) setLoading(false);
      }
    }

    loadStrategy();

    return () => {
      cancelled = true;
    };
  }, [pathname]);

  async function handleCreateRule(e: React.FormEvent) {
    e.preventDefault();
    if (!strategy) return;
    try {
      const rule = await createRule(strategy.id, { text: newRuleText, isRequired: newRuleRequired });
      setRules((prev) => [...prev, rule]);
      setShowAddRuleDialog(false);
      setNewRuleText("");
    } catch (err) {
      alert(err instanceof Error ? err.message : "Failed to create rule");
    }
  }

  async function handleUpdateRule(ruleId: string) {
    if (!strategy) return;
    try {
      const rule = await updateRule(strategy.id, ruleId, { text: editingRuleText, isRequired: editingRuleRequired });
      setRules((prev) => prev.map((r) => (r.id === ruleId ? rule : r)));
      setEditingRuleId(null);
    } catch (err) {
      alert(err instanceof Error ? err.message : "Failed to update rule");
    }
  }

  async function handleDeleteRule(ruleId: string) {
    if (!strategy) return;
    if (!confirm("Delete this rule?")) return;
    try {
      await deleteRule(strategy.id, ruleId);
      setRules((prev) => prev.filter((r) => r.id !== ruleId));
    } catch (err) {
      alert(err instanceof Error ? err.message : "Failed to delete rule");
    }
  }

  async function handleMoveRule(ruleId: string, direction: "up" | "down") {
    if (!strategy) return;
    const index = rules.findIndex((r) => r.id === ruleId);
    if (index === -1) return;
    const newIndex = direction === "up" ? index - 1 : index + 1;
    if (newIndex < 0 || newIndex >= rules.length) return;

    const newOrder = [...rules];
    const [moved] = newOrder.splice(index, 1);
    newOrder.splice(newIndex, 0, moved);

    try {
      await reorderRules(strategy.id, newOrder.map((r) => r.id));
      setRules(newOrder);
    } catch (err) {
      alert(err instanceof Error ? err.message : "Failed to reorder rule");
    }
  }

  function startEdit(rule: any) {
    setEditingRuleId(rule.id);
    setEditingRuleText(rule.text);
    setEditingRuleRequired(rule.isRequired);
  }

  if (loading) {
    return (
      <div className="flex h-96 items-center justify-center">
        <div className="h-8 w-8 animate-spin rounded-full border-2 border-accent border-t-transparent" />
      </div>
    );
  }

  if (error || !strategy) {
    return (
      <div className="text-center py-12">
        <p className="text-text-muted">{error ?? "Strategy not found"}</p>
      </div>
    );
  }

  return (
    <div className="space-y-5">
      <div className="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
        <div>
          <div className="flex items-center gap-2">
            <h1 className="text-2xl font-semibold text-text">{strategy.name}</h1>
            {strategy.status === "archived" && <Badge variant="neutral">Archived</Badge>}
          </div>
          <p className="text-sm text-text-muted mt-1">
            {strategy.tradeCount} trade(s) \u2022 {strategy.rules.length} rule(s)
            {strategy.category && " \u2022 " + strategy.category}
          </p>
        </div>
      </div>

      <Card title="Rules (drag-free ordered checklist)">
        {strategy.rules.length === 0 ? (
          <div className="text-center py-8">
            <p className="text-text-muted mb-4">No rules yet. Add your first rule to build the checklist.</p>
            <Button onClick={() => setShowAddRuleDialog(true)} variant="primary">
              Add Rule
            </Button>
          </div>
        ) : (
          <div>
            <ul className="divide-y divide-border">
              {strategy.rules.map((rule, index) => (
                <RuleItem
                  key={rule.id}
                  rule={rule}
                  index={index}
                  strategy={strategy}
                  editingRuleId={editingRuleId}
                  editingRuleText={editingRuleText}
                  editingRuleRequired={editingRuleRequired}
                  setEditingRuleId={setEditingRuleId}
                  setEditingRuleText={setEditingRuleText}
                  setEditingRuleRequired={setEditingRuleRequired}
                  handleUpdateRule={handleUpdateRule}
                  handleDeleteRule={handleDeleteRule}
                  handleMoveRule={handleMoveRule}
                  startEdit={startEdit}
                />
              ))}
            </ul>
            <div className="mt-4">
              <Button onClick={() => setShowAddRuleDialog(true)} variant="primary">
                Add Rule
              </Button>
            </div>
          </div>
        )}
      </Card>

      {showAddRuleDialog && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-black/50">
          <Card className="w-full max-w-md mx-4">
            <h2 className="text-lg font-semibold mb-4">Add Rule</h2>
            <form onSubmit={handleCreateRule} className="space-y-4">
              <div>
                <label className="block text-sm font-medium text-text-muted mb-1">Rule Text *</label>
                <Input
                  value={newRuleText}
                  onChange={(e) => setNewRuleText(e.target.value)}
                  required
                  maxLength={500}
                  placeholder="e.g. Price above 200 EMA on 15m timeframe"
                />
              </div>
              <label className="flex items-center gap-2">
                <input
                  type="checkbox"
                  checked={newRuleRequired}
                  onChange={(e) => setNewRuleRequired(e.target.checked)}
                  className="rounded border-border-strong"
                />
                <span className="text-sm text-text-muted">Required rule (must pass for trade to be valid)</span>
              </label>
              <div className="flex justify-end gap-2 pt-2">
                <Button type="button" variant="secondary" onClick={() => setShowAddRuleDialog(false)}>
                  Cancel
                </Button>
                <Button type="submit" variant="primary">Add Rule</Button>
              </div>
            </form>
          </Card>
        </div>
      )}
    </div>
  );
}