NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://tradeozeyid_app:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/tradeozeyid
DATABASE_URL_TEST=postgresql://tradeozeyid_app:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/tradeozeyid_test

JWT_ACCESS_SECRET=REPLACE_WITH_A_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
STORAGE_DIR=./backend/storage
